generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Accounts {
  username String   @id @db.VarChar(255)
  password String   @db.VarChar(255)
  balance  Decimal  @default(500.00) @db.Decimal(65, 2)
  Ledger   Ledger[]
}

model Ledger {
  id            Int      @id @default(autoincrement())
  username      String   @db.VarChar(255)
  service       Int
  beforeBalance Decimal  @db.Decimal(65, 2)
  afterBalance  Decimal  @db.Decimal(65, 2)
  timestamp     DateTime @db.Date
  Services      Services @relation(fields: [service], references: [id], onUpdate: Restrict, map: "fk_ledger_service_id")
  Accounts      Accounts @relation(fields: [username], references: [username], onUpdate: Restrict, map: "fk_ledger_username_username")

  @@index([service], map: "fk_ledger_service_id")
  @@index([username], map: "fk_ledger_username_username")
}

model Services {
  id     Int      @id @default(autoincrement())
  name   String   @unique(map: "name") @db.VarChar(255)
  token  String   @unique(map: "token") @db.VarChar(255)
  Ledger Ledger[]
}
