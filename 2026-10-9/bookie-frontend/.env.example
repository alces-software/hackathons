# Local (npm run dev) API_URL — the address the Next server reads the
# core at. Copy to .env and adjust to wherever the core is running.
API_URL=http://localhost:8000/api/v1

# Docker compose also reads this file, and takes exactly one value from it:
# NEXT_PUBLIC_WS_URL — the websocket the BROWSER should find the core on,
# baked into the client bundle when the frontend container builds. Only
# needed when the site is opened from another machine (the core's own
# address for the container itself lives in docker-compose.yml).
# NEXT_PUBLIC_WS_URL=ws://<vm-address>:3000/api/v1/ws